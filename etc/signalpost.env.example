# Copy to etc/signalpost.env (ignored), then chmod 600 that file.
HOST=127.0.0.1
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
DATA_DIRECTORY=var/lib/signalpost
POLL_INTERVAL_MS=60000

# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Google OAuth client type: Web application.
# Authorized redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Copy the ID from chrome://extensions after loading the build directory.
EXTENSION_IDS=
# Comma-separated verified Google emails. Empty means no admin users.
ADMIN_EMAILS=

# An installed and configured sendmail-compatible local MTA is required.
SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_FROM=
